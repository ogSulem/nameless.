# ─────────────────────────────────────────────────────────────────────────────
#  nameless. — example environment file
#  Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
#  Every value below is safe to publish: no real tokens, ids or credentials.
# ─────────────────────────────────────────────────────────────────────────────

# --- Telegram ----------------------------------------------------------------
# Token from @BotFather: "<digits>:<secret>"
BOT_TOKEN=000000000:REPLACE_ME

# Staff allow-lists (comma separated numeric telegram ids). Empty = nobody.
#   ADMINS     — full access, including other admins' actions
#   MODERATORS — users, complaints, bans, mutes
#   SUPPORT    — read-only: stats, user card, complaint history
# Leave empty in development: the admin menu is then closed to everyone.
ADMINS=
MODERATORS=
SUPPORT=

# Where error/ops alerts are sent (a numeric chat id, negative for groups).
# 0 = disabled (alerts then go to ADMINS).
ALERTS_CHAT_ID=0

# --- Storage -----------------------------------------------------------------
# Either DATABASE_URL/REDIS_URL, or the individual fields below.
DATABASE_URL=
REDIS_URL=

DB_HOST=postgres
DB_PORT=5432
DB_NAME=nameless
DB_USER=nameless
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Service -----------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8080
MEDIA_ROOT=/app/media

# --- Matching / dialogs ------------------------------------------------------
ONLINE_TTL_S=900          # how long a user counts as "online" without activity
DIALOG_MAX_HOURS=12       # hard cap on a single dialog (auto-closed by the sweeper)
PREMIUM_MIN_RATING=7.0      # premium prioritises partners at or above this chat rating
PREMIUM_MIN_APPEARANCE=7.0  # ... or this appearance rating, when the user picks that mode

# --- Growth ------------------------------------------------------------------
# Premium days awarded to the inviter when a friend registers via /invite.
REFERRAL_REWARD_DAYS=30
REFERRAL_WELCOME_DAYS=0
REFERRAL_MAX_PER_DAY=5
PROMO_ATTEMPTS_PER_HOUR=10

# Reliability: bounded pools and no infinite waits.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE_S=1800
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50
TELEGRAM_TIMEOUT_S=30

# --- Anti-flood --------------------------------------------------------------
MESSAGES_PER_10S=12
PHOTOS_PER_MINUTE=6

# --- Ratings -----------------------------------------------------------------
# Bayesian prior: protects newcomers from a single 0 rating.
RATING_PRIOR_MEAN=5.0
RATING_PRIOR_WEIGHT=5
RATING_MIN_COUNT=3        # ratings needed before a score is "established"
RATING_WINDOW=100         # window used for the "last N" averages

# --- Vision (face check before sending a photo) -------------------------------
# Uses OpenCV 4 only (no model downloads, no external API).
VISION_ENABLED=true
VISION_MAX_SIDE=640
VISION_TIMEOUT_S=4.0
VISION_CONCURRENCY=2

# --- Payments ----------------------------------------------------------------
# Option A: Telegram Payments (provider token from @BotFather, e.g. ЮKassa).
# Receipts (54-ФЗ) are handled by the provider.
PAYMENTS_PROVIDER_TOKEN=

# Option B: ЮKassa directly (no Telegram Payments). Requires both fields.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# Price in whole roubles. Premium is a one-off purchase: NO auto-renewal.
SUBSCRIPTION_PRICE_RUB=499
SUBSCRIPTION_DAYS=30

# --- Legal / retention -------------------------------------------------------
MIN_AGE=18
TERMS_VERSION=1.0
# Operator of personal data (152-ФЗ): your name/ИП/ООО, shown in /privacy.
OPERATOR_NAME=
# Support contact shown in /help and /privacy (e.g. @your_support).
SUPPORT_CONTACT=
RETENTION_MESSAGE_DAYS=30    # chat messages and photos are wiped after N days
RETENTION_COMPLAINT_DAYS=180 # complaints after N days
RETENTION_AUDIT_DAYS=365     # admin audit journal after N days
